# Canonical URL (canonical tags, OG/Twitter, sitemap, JSON-LD). Defaults to
# https://mafnan2018.vercel.app — set the SAME value on Vercel and Netlify so the
# Netlify mirror points search engines at the Vercel original.
NEXT_PUBLIC_SITE_URL=https://mafnan2018.vercel.app

# Search-engine ownership checks (the "HTML tag" method) — paste only the content="…" value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Contact form → Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# where messages are delivered
CONTACT_TO_EMAIL=m.afnan2018@gmail.com
# optional: a sender on a domain verified in Resend (defaults to onboarding@resend.dev)
CONTACT_FROM_EMAIL=

# GitHub heatmap (optional). Classic token with no scopes is enough (read:user).
# Without it the heatmap falls back to GitHub's public contributions page.
GITHUB_TOKEN=
